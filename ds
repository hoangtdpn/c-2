## 4️⃣ 💻 CODE MẪU C++ (Chuẩn Academic)

```cpp
// ============================================================================
// CÂU 2: Quản lý mảng - Nguyên tố, Max, Chính phương
// ============================================================================

#include <iostream>
#include <cmath>  // Dùng cho sqrt()
using namespace std;

const int MAX = 100;  // Kích thước tối đa của mảng

// ============================================================================
// HÀM PHỤ: Kiểm tra số nguyên tố
// ============================================================================
bool isPrime(int x) {
    if (x < 2) return false;
    if (x == 2) return true;
    if (x % 2 == 0) return false;
    
    for (int i = 3; i * i <= x; i += 2) {
        if (x % i == 0) return false;
    }
    return true;
}

// ============================================================================
// HÀM PHỤ: Kiểm tra số chính phương
// ============================================================================
/**
 * Hàm isPerfectSquare: Kiểm tra x có phải là bình phương của số nguyên không
 * @param x: số nguyên cần kiểm tra
 * @return: true nếu x là số chính phương, false nếu không
 */
bool isPerfectSquare(int x) {
    // Số âm không thể là số chính phương
    if (x < 0) {
        return false;
    }
    
    // Tính căn bậc 2 và lấy phần nguyên
    int can = static_cast<int>(sqrt(x));
    
    // Kiểm tra: nếu can² == x thì x là số chính phương
    // Ví dụ: x=16 → can=4 → 4*4=16 → true
    // Ví dụ: x=15 → can=3 → 3*3=9 ≠ 15 → false
    return (can * can == x);
}

// ============================================================================
// 2.1: Hàm nhập mảng
// ============================================================================
void inputArray(int a[], int &n) {
    do {
        cout << "Nhap so luong phan tu n (1 <= n <= 100): ";
        cin >> n;
        if (n < 1 || n > MAX) {
            cout << "Loi: n phai trong khoang [1, 100]!\n";
        }
    } while (n < 1 || n > MAX);
    
    cout << "Nhap " << n << " so nguyen:\n";
    for (int i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }
}

// ============================================================================
// 2.2: Đếm và liệt kê số nguyên tố
// ============================================================================
/**
 * Hàm countPrimes: Đếm và in các số nguyên tố trong mảng
 * @param a[]: mảng số nguyên
 * @param n: số lượng phần tử
 */
void countPrimes(int a[], int n) {
    int dem = 0;
    
    cout << "\nCac so nguyen to trong mang:\n";
    
    for (int i = 0; i < n; i++) {
        if (isPrime(a[i])) {
            dem++;
            // In vị trí (i+1 vì đề đếm từ 1) và giá trị
            cout << "  Vi tri " << (i + 1) << ": " << a[i] << endl;
        }
    }
    
    cout << "So luong so nguyen to tim duoc: " << dem << endl;
}

// ============================================================================
// 2.3: Tìm max và kiểm tra chính phương
// ============================================================================
/**
 * Hàm findMaxAndCheckPerfectSquare: Tìm max và kiểm tra tính chính phương
 * @param a[]: mảng số nguyên
 * @param n: số lượng phần tử
 */
void findMaxAndCheckPerfectSquare(int a[], int n) {
    // Bước 1: Tìm giá trị lớn nhất
    int maxVal = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] > maxVal) {
            maxVal = a[i];
        }
    }
    
    // Bước 2: In kết quả
    cout << "\nGia tri lon nhat trong mang: " << maxVal << endl;
    
    if (isPerfectSquare(maxVal)) {
        // Tìm căn bậc 2 để in cho đẹp
        int can = static_cast<int>(sqrt(maxVal));
        cout << maxVal << " LA so chinh phuong (vi " << maxVal << " = " << can << "^2)." << endl;
    } else {
        cout << maxVal << " KHONG PHAI la so chinh phuong." << endl;
    }
}

// ============================================================================
// 2.4: Hàm main()
// ============================================================================
int main() {
    int a[MAX];
    int n;
    
    cout << "=== NHAP MANG ===" << endl;
    inputArray(a, n);
    
    cout << "\n=== DEM SO NGUYEN TO ===" << endl;
    countPrimes(a, n);
    
    cout << "\n=== TIM MAX VA KIEM TRA CHINH PHUONG ===" << endl;
    findMaxAndCheckPerfectSquare(a, n);
    
    return 0;
}
```

