## 4️⃣ 💻 CODE MẪU C++ (Chuẩn Academic)

```cpp
// ============================================================================
// ĐỀ THI GIỮA KỲ SỐ 3 - LẬP TRÌNH CƠ BẢN
// Tác giả: Trợ giảng C++ | Dành cho Sinh viên Năm 1
// ============================================================================

#include <iostream>
#include <cmath>    // sqrt()
#include <iomanip>  // setprecision()
using namespace std;

const int MAX_N = 100;

// ============================================================================
// CÂU 1: Tính tổng đan dấu P
// ============================================================================
double tinhTongP(int n) {
    double P = 1.0;      // Số hạng đầu tiên
    double dau = -1.0;   // Dấu của số hạng tiếp theo (k=1 là âm)
    
    for (int k = 1; k <= n; k++) {
        int mau = (2 * k) * (2 * k);       // (2k)^2
        double soHang = dau / mau;         // (-1)^k / (2k)^2
        P += soHang;                       // Cộng vào tổng
        dau *= -1.0;                       // Đảo dấu cho lượt sau: -1 -> 1 -> -1...
    }
    return P;
}

// ============================================================================
// HÀM PHỤ: Kiểm tra số chính phương trên số thực
// ============================================================================
bool isPerfectSquare(double x) {
    if (x < 0.0) return false;  // Số âm không thể là chính phương
    
    // Lấy căn bậc 2 và làm tròn về số nguyên gần nhất (+0.5 để tránh sai số float)
    int can = static_cast<int>(sqrt(x) + 0.5);
    
    // Kiểm tra lại: nếu bình phương số nguyên bằng đúng giá trị gốc → là chính phương
    return (can * can == x);
}

// ============================================================================
// CÂU 2.1: Nhập mảng số thực
// ============================================================================
void nhapMangThuc(double a[], int &n) {
    do {
        cout << "Nhap so phan tu n (1 <= n <= 100): ";
        cin >> n;
        if (n < 1 || n > MAX_N) {
            cout << "Loi: n phai trong khoang [1, 100].\n";
        }
    } while (n < 1 || n > MAX_N);
    
    cout << "Nhap " << n << " so thuc:\n";
    for (int i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }
}

// ============================================================================
// CÂU 2.2: Đếm và in số dương
// ============================================================================
void demVaInSoDuong(double a[], int n) {
    int dem = 0;
    cout << "\nCac so duong trong mang: ";
    for (int i = 0; i < n; i++) {
        if (a[i] > 0.0) {  // Chỉ chọn số LỚN HƠN 0
            dem++;
            cout << a[i] << "  ";
        }
    }
    cout << "\nSo luong: " << dem << endl;
}

// ============================================================================
// CÂU 2.3: Tìm max và kiểm tra chính phương
// ============================================================================
void timMaxKiemTraChinhPhuong(double a[], int n) {
    double maxVal = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] > maxVal) {
            maxVal = a[i];
        }
    }
    
    cout << "\nGia tri lon nhat: " << maxVal << endl;
    if (isPerfectSquare(maxVal)) {
        int can = static_cast<int>(sqrt(maxVal) + 0.5);
        cout << maxVal << " LA so chinh phuong (vi " << maxVal << " = " << can << "^2).\n";
    } else {
        cout << maxVal << " KHONG PHAI la so chinh phuong.\n";
    }
}

// ============================================================================
// MAIN
// ============================================================================
int main() {
    int n;
    double a[MAX_N];
    
    cout << "=== CAU 1: TINH TONG P ===" << endl;
    int n_p;
    do {
        cout << "Nhap n (n >= 1): ";
        cin >> n_p;
    } while (n_p < 1);
    cout << fixed << setprecision(4);
    cout << "Ket qua: P = " << tinhTongP(n_p) << endl << endl;
    
    cout << "=== CAU 2: QUAN LY MANG SO THUC ===" << endl;
    nhapMangThuc(a, n);
    demVaInSoDuong(a, n);
    timMaxKiemTraChinhPhuong(a, n);
    
    return 0;
}
```

