## 4️⃣ 💻 CODE MẪU C++ (Chuẩn Academic cho Sinh viên Năm 1)

```cpp
// ============================================================================
// BÀI TẬP CÂU 2: Quản lý mảng số nguyên - Nhập, đếm, tìm min, kiểm tra nguyên tố
// Tác giả: Trợ giảng C++ - Dành cho sinh viên năm 1
// Ngôn ngữ: C++11, biên dịch bằng g++ -std=c++11
// ============================================================================

#include <iostream>
#include <cmath>  // Dùng cho hàm sqrt() trong kiểm tra nguyên tố
using namespace std;  // Giúp code ngắn gọn cho bài tập năm 1

// ============================================================================
// PHẦN 2.1: Hàm nhập mảng n số nguyên
// ============================================================================
/**
 * Hàm nhapMang: Nhập số phần tử n và các giá trị của mảng
 * @param a[]: mảng số nguyên (truyền theo tham chiếu)
 * @param n: tham chiếu đến biến n để hàm có thể gán giá trị nhập vào
 */
void nhapMang(int a[], int &n) {
    // Bước 1: Nhập và kiểm tra số lượng phần tử
    do {
        cout << "Nhap so luong phan tu n (1 <= n <= 100): ";
        cin >> n;
        if (n < 1 || n > 100) {
            cout << "Loi: n phai trong khoang [1, 100]. Vui long nhap lai!\n";
        }
    } while (n < 1 || n > 100);  // Lặp lại nếu nhập sai
    
    // Bước 2: Nhập từng phần tử của mảng
    cout << "Nhap " << n << " so nguyen:\n";
    for (int i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];  // Nhập giá trị vào vị trí thứ i
    }
}

// ============================================================================
// PHẦN 2.2: Hàm đếm số chia hết cho 3 và in vị trí
// ============================================================================
/**
 * Hàm demChiaHetCho3: Đếm và in các vị trí có giá trị chia hết cho 3
 * @param a[]: mảng số nguyên đầu vào
 * @param n: số lượng phần tử của mảng
 * Lưu ý: Vị trí in ra bắt đầu từ 1 (theo yêu cầu đề bài)
 */
void demChiaHetCho3(int a[], int n) {
    int dem = 0;  // Biến đếm số lượng thỏa mãn
    
    cout << "\nCac vi tri co gia tri chia het cho 3: ";
    
    // Duyệt toàn bộ mảng
    for (int i = 0; i < n; i++) {
        // Kiểm tra chia hết cho 3: phần dư của phép chia a[i] cho 3 bằng 0
        // Lưu ý: Với số âm, -6 % 3 vẫn bằng 0 → đúng
        if (a[i] % 3 == 0) {
            dem++;  // Tăng biến đếm
            cout << (i + 1) << " ";  // In vị trí (i+1 vì đề bài đếm từ 1)
        }
    }
    
    // In tổng số lượng tìm được
    cout << "\nSo luong: " << dem << endl;
}

// ============================================================================
// HÀM PHỤ: Kiểm tra số nguyên tố (dùng cho phần 2.3)
// ============================================================================
/**
 * Hàm isPrime: Kiểm tra một số có phải là số nguyên tố hay không
 * @param x: số nguyên cần kiểm tra
 * @return: true nếu x là nguyên tố, false nếu không
 * 
 * Số nguyên tố: số tự nhiên > 1, chỉ chia hết cho 1 và chính nó
 * Ví dụ: 2, 3, 5, 7, 11, 13... là nguyên tố; 1, 4, 6, 8, 9... không phải
 */
bool isPrime(int x) {
    // Trường hợp đặc biệt: số < 2 không phải nguyên tố
    if (x < 2) {
        return false;
    }
    
    // Trường hợp x = 2 là nguyên tố nhỏ nhất
    if (x == 2) {
        return true;
    }
    
    // Loại trừ các số chẵn > 2 (không phải nguyên tố)
    if (x % 2 == 0) {
        return false;
    }
    
    // Kiểm tra các ước lẻ từ 3 đến sqrt(x)
    // Tại sao đến sqrt(x)? Vì nếu x = a*b, thì ít nhất 1 ước ≤ sqrt(x)
    for (int i = 3; i <= sqrt(x); i += 2) {  // i += 2 để chỉ duyệt số lẻ
        if (x % i == 0) {  // Nếu tìm thấy ước → không phải nguyên tố
            return false;
        }
    }
    
    // Nếu không tìm thấy ước nào → là nguyên tố
    return true;
}

// ============================================================================
// PHẦN 2.3: Tìm giá trị nhỏ nhất và kiểm tra có phải nguyên tố không
// ============================================================================
/**
 * Hàm timMinVaKiemTraNguyenTo: Tìm min trong mảng và kiểm tra tính nguyên tố
 * @param a[]: mảng số nguyên đầu vào
 * @param n: số lượng phần tử của mảng
 */
void timMinVaKiemTraNguyenTo(int a[], int n) {
    // Bước 1: Tìm giá trị nhỏ nhất
    int minVal = a[0];  // Giả sử phần tử đầu tiên là nhỏ nhất
    
    for (int i = 1; i < n; i++) {  // Bắt đầu duyệt từ phần tử thứ 2 (chỉ số 1)
        if (a[i] < minVal) {  // Nếu tìm thấy phần tử nhỏ hơn min hiện tại
            minVal = a[i];  // Cập nhật lại giá trị nhỏ nhất
        }
    }
    
    // Bước 2: In giá trị nhỏ nhất tìm được
    cout << "\nGia tri nho nhat trong mang: " << minVal << endl;
    
    // Bước 3: Kiểm tra và thông báo kết quả nguyên tố
    if (isPrime(minVal)) {
        cout << minVal << " LA so nguyen to." << endl;
    } else {
        cout << minVal << " KHONG PHAI la so nguyen to." << endl;
    }
}

// ============================================================================
// PHẦN 2.4: Hàm main() - Điều phối chương trình chính
// ============================================================================
int main() {
    int a[100];  // Khai báo mảng tĩnh với kích thước tối đa 100 (theo ràng buộc)
    int n;       // Biến lưu số lượng phần tử thực tế
    
    // Bước 1: Gọi hàm nhập mảng
    cout << "=== NHAP MANG ===" << endl;
    nhapMang(a, n);
    
    // Bước 2: Gọi hàm đếm số chia hết cho 3
    cout << "\n=== DEM SO CHIA HET CHO 3 ===" << endl;
    demChiaHetCho3(a, n);
    
    // Bước 3: Gọi hàm tìm min và kiểm tra nguyên tố
    cout << "\n=== TIM MIN VA KIEM TRA NGUYEN TO ===" << endl;
    timMinVaKiemTraNguyenTo(a, n);
    
    return 0;  // Kết thúc chương trình thành công
}
```

📌 **Giải thích kỹ thuật quan trọng**:
1. **Truyền `int &n` trong `nhapMang`**: Dấu `&` là **tham chiếu**, giúp hàm thay đổi trực tiếp biến `n` ở `main()`. Nếu không có `&`, `n` trong `main()` sẽ không nhận được giá trị nhập vào.
2. **Vị trí in ra là `i+1`**: Vì mảng C++ đánh chỉ số từ 0, nhưng đề bài (và người dùng) quen đếm từ 1 → cần điều chỉnh khi hiển thị.
3. **Tối ưu `isPrime`**: 
   - Loại trừ số chẵn trước để giảm một nửa số lần lặp.
   - Duyệt đến `sqrt(x)` thay vì `x-1` → giảm đáng kể thời gian với số lớn.

