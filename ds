## 4️⃣ 💻 CODE MẪU C++ (Chuẩn Academic)

```cpp
// ============================================================================
// ĐỀ KIỂM TRA GIỮA KỲ SỐ 5 - LẬP TRÌNH CƠ BẢN
// Tác giả: Trợ giảng C++ | Dành cho Sinh viên Năm 1
// ============================================================================

#include <iostream>
#include <iomanip>  // setprecision, fixed
using namespace std;

const int MAX_N = 100;

// ============================================================================
// CÂU 1: Tính tổng S = 1 + 2/2! + 3/3! + ... + n/n!
// ============================================================================
double tinhTongS(int n) {
    double S = 0.0;
    double giaiThua = 1.0;  // Dùng double để tránh tràn số int khi n lớn
    
    for (int i = 1; i <= n; i++) {
        giaiThua *= i;                      // Cập nhật giai thừa dồn: i! = (i-1)! * i
        double soHang = (double)i / giaiThua; // Ép kiểu để đảm bảo chia thực
        S += soHang;                        // Cộng dồn vào tổng
    }
    return S;
}

// ============================================================================
// CÂU 2.1: Nhập mảng n số nguyên
// ============================================================================
void nhapMang(int a[], int &n) {
    do {
        cout << "Nhap so phan tu n (n > 0): ";
        cin >> n;
        if (n <= 0) {
            cout << "Loi: n phai la so nguyen duong!\n";
        }
    } while (n <= 0);
    
    cout << "Nhap " << n << " so nguyen:\n";
    for (int i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }
}

// ============================================================================
// CÂU 2.2: Tách và in số chẵn, số lẻ
// ============================================================================
void tachChanLe(int a[], int n) {
    int chan[MAX_N], le[MAX_N];
    int cntChan = 0, cntLe = 0;
    
    // Bước 1: Duyệt và tách
    for (int i = 0; i < n; i++) {
        if (a[i] % 2 == 0) {
            chan[cntChan++] = a[i];
        } else {
            le[cntLe++] = a[i];
        }
    }
    
    // Bước 2: In dãy chẵn
    cout << "\nDay so chan: ";
    if (cntChan > 0) {
        for (int i = 0; i < cntChan; i++) {
            cout << chan[i] << "  ";
        }
    } else {
        cout << "Khong co";
    }
    cout << endl;
    
    // Bước 3: In dãy lẻ
    cout << "Day so le : ";
    if (cntLe > 0) {
        for (int i = 0; i < cntLe; i++) {
            cout << le[i] << "  ";
        }
    } else {
        cout << "Khong co";
    }
    cout << endl;
}

// ============================================================================
// CÂU 2.3: Kiểm tra mảng đối xứng
// ============================================================================
bool kiemTraDoiXung(int a[], int n) {
    // Chỉ cần duyệt nửa đầu, so sánh với nửa cuối
    for (int i = 0; i < n / 2; i++) {
        if (a[i] != a[n - 1 - i]) {
            return false;  // Phát hiện cặp không khớp → không đối xứng
        }
    }
    return true;  // Duyệt hết nửa đầu mà không phát hiện sai → đối xứng
}

// ============================================================================
// MAIN
// ============================================================================
int main() {
    int n;
    int a[MAX_N];
    
    cout << "=== CAU 1: TINH TONG S ===" << endl;
    int n_p;
    do {
        cout << "Nhap n (n >= 1): ";
        cin >> n_p;
        if (n_p < 1) cout << "Loi: n phai >= 1!\n";
    } while (n_p < 1);
    
    cout << fixed << setprecision(3);
    cout << "Ket qua: S = " << tinhTongS(n_p) << endl << endl;
    
    cout << "=== CAU 2: XU LY MANG ===" << endl;
    nhapMang(a, n);
    tachChanLe(a, n);
    
    cout << "\nKiem tra doi xung: ";
    if (kiemTraDoiXung(a, n)) {
        cout << "MANG DOI XUNG" << endl;
    } else {
        cout << "MANG KHONG DOI XUNG" << endl;
    }
    
    return 0;
}
```

📌 **Giải thích kỹ thuật quan trọng:**
- `giaiThua` kiểu `double`: Tránh `int overflow` khi $n \ge 13$, đồng thời tương thích phép chia.
- `cntChan++` trong `chan[cntChan++] = a[i]`: Gán giá trị rồi mới tăng bộ đếm → đúng chỉ số mảng.
- `n / 2` trong vòng lặp đối xứng: Toán tử `/` trên số nguyên tự làm tròn xuống. Với $n=5$, $n/2=2$ → duyệt $i=0,1$ (so sánh cặp 0-4, 1-3). Phần tử giữa $a[2]$ tự đối xứng với chính nó → không cần kiểm tra.

