## 4️⃣ 💻 CODE MẪU C++ (Chuẩn Academic)

```cpp
// ============================================================================
// CÂU 1: Tính tổng S = 1 + 1/2³ + 1/3³ + ... + 1/n³
// ============================================================================

#include <iostream>
#include <iomanip>  // Cần cho setprecision để định dạng số thập phân
using namespace std;

/**
 * Hàm calculateSum: Tính tổng chuỗi nghịch đảo lập phương
 * @param n: số nguyên dương, số hạng cuối là 1/n³
 * @return: giá trị tổng S (kiểu double)
 */
double calculateSum(int n) {
    double tong = 0.0;  // Khởi tạo tổng = 0.0
    
    // Vòng lặp từ i = 1 đến n (theo đúng công thức)
    for (int i = 1; i <= n; i++) {
        // Tính mẫu số: i³ = i * i * i
        // Dùng phép nhân trực tiếp thay vì pow() để tránh sai số
        int muSo = i * i * i;
        
        // Tính số hạng: 1.0 / muSo
        // QUAN TRỌNG: 1.0 (không phải 1) để đảm bảo phép chia thực
        double soHang = 1.0 / muSo;
        
        // Cộng vào tổng
        tong += soHang;  // Tương đương: tong = tong + soHang;
    }
    
    return tong;
}

int main() {
    int n;
    
    // Nhập và kiểm tra điều kiện n >= 1
    do {
        cout << "Nhap so nguyen duong n: ";
        cin >> n;
        if (n < 1) {
            cout << "Loi: n phai la so nguyen duong (n >= 1)!\n";
        }
    } while (n < 1);
    
    // Gọi hàm tính tổng
    double ketQua = calculateSum(n);
    
    // Định dạng in ra với 6 chữ số thập phân
    cout << fixed << setprecision(6);
    cout << "Ket qua: S = " << ketQua << endl;
    
    return 0;
}
```

