## 4️⃣ 💻 CODE MẪU C++ (Chuẩn Academic cho Sinh viên Năm 1)

```cpp
// ============================================================================
// BÀI TẬP: Tính tổng S = 1 + 1/3² + 1/5² + ... + 1/(2n+1)²
// Tác giả: Trợ giảng C++ - Dành cho sinh viên năm 1
// Ngôn ngữ: C++11, biên dịch bằng g++ -std=c++11
// ============================================================================

#include <iostream>   // Thư viện nhập/xuất cơ bản: cin, cout
// Lưu ý: Không dùng using namespace std; trong dự án lớn, 
// nhưng trong bài tập năm 1, nó giúp code ngắn gọn, dễ đọc.
using namespace std;

/**
 * Hàm tinhTongS: Tính giá trị tổng S theo công thức đề bài
 * @param n: số nguyên không âm, xác định số hạng cuối 1/(2n+1)²
 * @return: giá trị tổng S (kiểu double để lưu phần thập phân)
 */
double tinhTongS(int n) {
    double tong = 0.0;  // Khởi tạo tổng = 0.0 (bắt buộc dùng double)
    
    // Vòng lặp từ i = 0 đến i = n (tổng cộng n+1 số hạng)
    for (int i = 0; i <= n; i++) {
        // Tính mẫu số: (2*i + 1)² 
        // Ví dụ: i=0 → 1²=1; i=1 → 3²=9; i=2 → 5²=25
        int mauSo = (2 * i + 1) * (2 * i + 1);
        
        // Tính số hạng hiện tại: 1.0 / mauSo
        // QUAN TRỌNG: Viết 1.0 (không phải 1) để đảm bảo phép chia thực
        // Nếu viết 1/9 → kết quả là 0 (chia nguyên), sai!
        double soHang = 1.0 / mauSo;
        
        // Cộng số hạng vào tổng
        tong = tong + soHang;  // Hoặc viết gọn: tong += soHang;
    }
    
    return tong;  // Trả kết quả về cho nơi gọi hàm
}

/**
 * Hàm main: Điểm bắt đầu của chương trình
 */
int main() {
    int n;  // Biến lưu số n nhập từ bàn phím
    
    // Yêu cầu người dùng nhập dữ liệu
    cout << "Nhap so nguyen n (n >= 0): ";
    cin >> n;
    
    // Kiểm tra điều kiện hợp lệ (phòng lỗi người dùng nhập âm)
    if (n < 0) {
        cout << "Loi: n phai la so nguyen khong am!" << endl;
        return 1;  // Trả về mã lỗi 1 để báo chương trình kết thúc không thành công
    }
    
    // Gọi hàm tính tổng và lưu kết quả
    double ketQua = tinhTongS(n);
    
    // In kết quả với 6 chữ số thập phân (mặc định của cout)
    // Nếu muốn đẹp hơn: dùng cout << fixed << setprecision(6) << ketQua;
    cout << "Ket qua: S = " << ketQua << endl;
    
    return 0;  // Chương trình kết thúc thành công
}
```

📌 **Giải thích thêm về `using namespace std;`**:
- Trong môi trường học tập năm 1: Dùng để tránh viết `std::cout`, `std::cin` → code ngắn, dễ tập trung vào thuật toán.
- Trong dự án thực tế: Nên tránh vì có thể gây xung đột tên. Thay vào đó, viết rõ `std::cout`.

