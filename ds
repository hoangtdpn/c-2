#include <iostream>
#include <climits>  // Cần cho INT_MIN
using namespace std;

const int MAX_N = 100;

// ============================================================================
// CÂU 1: Tính tích các số lẻ T = 1 * 3 * 5 * ... * (2n-1)
// ============================================================================
long long tinhTichLe(int n) {
    if (n == 0) return 1;  // Trường hợp đặc biệt theo đề bài
    
    long long T = 1;       // Khởi tạo tích = 1
    for (int i = 1; i <= n; i++) {
        int soLe = 2 * i - 1;  // Số lẻ thứ i: 1, 3, 5...
        T *= soLe;             // Nhân dồn vào T
    }
    return T;
}

// ============================================================================
// HÀM PHỤ: Kiểm tra số đối xứng (Palindrome)
// ============================================================================
bool isPalindrome(int x) {
    if (x < 0) return false;  // Số âm không xét đối xứng trong bài này
    
    int temp = x;
    int reversed = 0;
    while (temp > 0) {
        int chuSo = temp % 10;           // Lấy chữ số cuối
        reversed = reversed * 10 + chuSo; // Ghép vào số đảo
        temp /= 10;                      // Loại chữ số cuối
    }
    return reversed == x;  // So sánh số gốc và số đảo
}

// ============================================================================
// CÂU 2.1: Nhập mảng n số nguyên
// ============================================================================
void nhapMang(int a[], int &n) {
    do {
        cout << "Nhap so phan tu n (1 <= n <= 100): ";
        cin >> n;
        if (n < 1 || n > MAX_N) {
            cout << "Loi: n phai trong khoang [1, 100]!\n";
        }
    } while (n < 1 || n > MAX_N);
    
    cout << "Nhap " << n << " so nguyen:\n";
    for (int i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }
}

// ============================================================================
// CÂU 2.2: Đếm và liệt kê số đối xứng
// ============================================================================
void lietKeDoiXung(int a[], int n) {
    int dem = 0;
    cout << "\nCac so doi xung trong mang: ";
    for (int i = 0; i < n; i++) {
        if (isPalindrome(a[i])) {
            dem++;
            cout << a[i] << "  ";
        }
    }
    cout << "\nSo luong: " << dem << endl;
}

// ============================================================================
// CÂU 2.3: Tìm số lớn thứ hai
// ============================================================================
void timSoLonThuHai(int a[], int n) {
    int max1 = a[0];          // Số lớn nhất
    int max2 = INT_MIN;       // Số lớn thứ hai (khởi tạo giá trị nhỏ nhất của int)
    bool foundSecond = false; // Cờ đánh dấu đã tìm thấy số lớn thứ hai chưa
    
    for (int i = 1; i < n; i++) {
        if (a[i] > max1) {
            // Tìm thấy số mới LỚN HƠN max1 cũ → max1 cũ đẩy xuống max2
            max2 = max1;
            max1 = a[i];
            foundSecond = true;
        } else if (a[i] > max2 && a[i] != max1) {
            // Số không lớn hơn max1, nhưng lớn hơn max2 và khác max1 → cập nhật max2
            max2 = a[i];
            foundSecond = true;
        }
    }
    
    cout << "\n";
    if (foundSecond) {
        cout << "So lon thu hai trong mang la: " << max2 << endl;
    } else {
        cout << "Khong co so lon thu hai." << endl;
    }
}

// ============================================================================
// MAIN
// ============================================================================
int main() {
    int n, n_p;
    int a[MAX_N];
    
    // --- Câu 1 ---
    cout << "=== CAU 1: TINH TICH SO LE ===" << endl;
    do {
        cout << "Nhap n (n >= 0): ";
        cin >> n_p;
        if (n_p < 0) cout << "Loi: n phai >= 0!\n";
    } while (n_p < 0);
    
    cout << "Ket qua: T = " << tinhTichLe(n_p) << endl << endl;
    
    // --- Câu 2 ---
    cout << "=== CAU 2: XU LY MANG ===" << endl;
    nhapMang(a, n);
    lietKeDoiXung(a, n);
    timSoLonThuHai(a, n);
    
    return 0;
}
```

