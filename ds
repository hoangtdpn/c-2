DeepSeek: 👋 Tiếp nè bạn! Mình sẽ giải Câu 2 với cấu trúc chi tiết như đã hứa.Lưu ý: Đề bài dùng mảng tĩnh (phù hợp sinh viên năm 1) – mình sẽ giả định số lượng phần tử tối đa là 1000 (hoặc nhập từ bàn phím).1️⃣ 📖 PHÂN TÍCH ĐỀ BÀI (Câu 2)Yêu cầu bằng ngôn ngữ đời thườngNhập số nguyên dương n (kích thước mảng).Nhập n số nguyên vào mảng.Đếm xem có bao nhiêu số chia hết cho 3, in ra số lượng và vị trí của chúng (vị trí tính từ 1).Tìm giá trị nhỏ nhất trong mảng, rồi kiểm tra số đó có phải là số nguyên tố không.Làm tất cả bằng hàm, main() chỉ gọi.Input / Output / Ràng buộcThành phầnMô tảInput- Dòng 1: số nguyên n (1 ≤ n ≤ 1000)  - Dòng 2: n số nguyên (có thể âm, dương)Output- Dòng 1: số lượng số chia hết cho 3 và danh sách vị trí  - Dòng 2: giá trị nhỏ nhất và kết luận "là số nguyên tố" hoặc "không là số nguyên tố"Ràng buộcn tối đa 1000, giá trị số nguyên trong khoảng intKhái niệm C++ liên quanMảng tĩnh: int a[1000]; – lưu nhiều số cùng kiểu, truy cập qua chỉ số từ 0.Hàm nhập mảng: tham số là mảng và kích thước (truyền bằng tham chiếu ngầm).Số nguyên tố: số &gt; 1, chỉ chia hết cho 1 và chính nó.Vị trí trong đề bài: tính từ 1 (nhưng code dùng chỉ số 0 → in ra +1).2️⃣ 🧠 TƯ DUY GIẢI QUYẾT (Step-by-Step)Hàm 1: Nhập mảngNhập n (kiểm tra n &gt; 0, n ≤ 1000).Dùng vòng lặp for (int i = 0; i &lt; n; i++) để nhập từng phần tử.Hàm 2: Đếm số chia hết cho 3 &amp; in vị tríDuyệt mảng từ đầu đến cuối.Nếu a[i] % 3 == 0:Tăng biến đếmIn ra vị trí i + 1Cuối cùng in tổng số lượng.Hàm 3: Tìm giá trị nhỏ nhất &amp; kiểm tra nguyên tốTìm min: gán minVal = a[0], duyệt từ i=1 đến n-1, nếu a[i] &lt; minVal thì cập nhật.Kiểm tra nguyên tố:Nếu minVal &lt;= 1 → không nguyên tốDùng vòng lặp từ 2 đến sqrt(minVal), nếu chia hết → không nguyên tốNgược lại → nguyên tố.Hàm main()Khai báo mảng và biến n.Gọi hàm nhập mảng.Gọi hàm đếm &amp; in vị trí.Gọi hàm tìm min &amp; kiểm tra nguyên tố.3️⃣ 📊 LƯU ĐỒ THUẬT TOÁN (FLOWCHART)Flowchart hàm đếm số chia hết cho 3DiagramCode.kvfysmfp{overflow:hidden;touch-action:none}.ufhsfnkm{transform-origin: 0 0}Flowchart kiểm tra số nguyên tốDiagramCode.kvfysmfp{overflow:hidden;touch-action:none}.ufhsfnkm{transform-origin: 0 0}4️⃣ 💻 CODE MẪU C++ – CÂU 2 (chi tiết, comment đầy đủ)cpp#include &lt;iostream&gt;
#include &lt;cmath&gt;     // dùng cho sqrt()
using namespace std;

// 1. Hàm nhập mảng
void nhapMang(int a[], int &amp;n) {
    cout &lt;&lt; "Nhập số lượng phần tử n: ";
    cin &gt;&gt; n;
    
    // Kiểm tra giới hạn (năm 1 nên xử lý đơn giản)
    if (n &lt;= 0 || n &gt; 1000) {
        cout &lt;&lt; "Số lượng không hợp lệ, đặt n = 1000" &lt;&lt; endl;
        n = 1000;
    }
    
    cout &lt;&lt; "Nhập " &lt;&lt; n &lt;&lt; " số nguyên: ";
    for (int i = 0; i &lt; n; i++) {
        cin &gt;&gt; a[i];
    }
}

// 2. Hàm đếm số chia hết cho 3 và in vị trí
void demVaInViTriChiaHetCho3(int a[], int n) {
    int dem = 0;
    cout &lt;&lt; "Các số chia hết cho 3 tại vị trí: ";
    
    for (int i = 0; i &lt; n; i++) {
        if (a[i] % 3 == 0) {
            dem++;
            cout &lt;&lt; i + 1 &lt;&lt; " ";  // vị trí bắt đầu từ 1 theo yêu cầu đề
        }
    }
    
    cout &lt;&lt; endl;
    cout &lt;&lt; "Số lượng số chia hết cho 3: " &lt;&lt; dem &lt;&lt; endl;
}

// 3. Hàm kiểm tra số nguyên tố
bool kiemTraNguyenTo(int x) {
    if (x &lt;= 1) return false;      // 0, 1, số âm không là nguyên tố
    
    for (int i = 2; i * i &lt;= x; i++) {
        if (x % i == 0) return false;
    }
    return true;
}

// 4. Hàm tìm giá trị nhỏ nhất và kiểm tra nguyên tố
void timMinVaKiemTraNguyenTo(int a[], int n) {
    if (n == 0) {
        cout &lt;&lt; "Mảng rỗng!" &lt;&lt; endl;
        return;
    }
    
    int minVal = a[0];
    for (int i = 1; i &lt; n; i++) {
        if (a[i] &lt; minVal) {
            minVal = a[i];
        }
    }
    
    cout &lt;&lt; "Giá trị nhỏ nhất trong mảng: " &lt;&lt; minVal &lt;&lt; endl;
    
    if (kiemTraNguyenTo(minVal)) {
        cout &lt;&lt; minVal &lt;&lt; " là số nguyên tố" &lt;&lt; endl;
    } else {
        cout &lt;&lt; minVal &lt;&lt; " không là số nguyên tố" &lt;&lt; endl;
    }
}

// 5. Hàm main
int main() {
    int a[1000];   // mảng tĩnh tối đa 1000 phần tử
    int n;
    
    // Gọi hàm nhập mảng
    nhapMang(a, n);
    
    // Gọi hàm đếm số chia hết cho 3 và in vị trí
    demVaInViTriChiaHetCho3(a, n);
    
    // Gọi hàm tìm min và kiểm tra nguyên tố
    timMinVaKiemTraNguyenTo(a, n);
    
    return 0;
}Giải thích code chi tiếtvoid nhapMang(int a[], int &amp;n): tham số &amp;n là tham chiếu để thay đổi giá trị n ngay trong hàm.demVaInViTriChiaHetCho3: dùng % 3 == 0 để kiểm tra chia hết.kiemTraNguyenTo: dùng i * i &lt;= x thay vì sqrt(x) để tránh dùng double.timMinVaKiemTraNguyenTo: gọi hàm kiểm tra nguyên tố bên trong.5️⃣ 🔍 KIỂM TRA &amp; CHẠY THỬ (Câu 2)Test case 1: Bình thường (đề bài ví dụ)Input:text7
