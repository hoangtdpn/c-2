    CalcFact --> CalcTerm[soHang = (double)i / giaiThua]
    CalcTerm --> Update[S += soHang]
    Update --> Inc[i++]
    Inc --> Cond
    
    Cond -- Sai --> Format[cout << fixed << setprecision(3)]
    Format --> Output[/In "S = " << S/]
