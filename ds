#include &lt;iomanip&gt;  // dùng để setprecision (in số với độ chính xác cao)
using namespace std;

// Hàm tính tổng S = 1 + 1/3^2 + 1/5^2 + ... + 1/(2n+1)^2
double tinhTong(int n) {
    double tong = 0.0;      // Biến lưu tổng, kiểu double để lưu số thập phân

    for (int i = 0; i &lt;= n; i++) {
        // i = 0 -&gt; mẫu số = 1 (số hạng đầu bằng 1)
        // i = 1 -&gt; mẫu số = 3
        // i = 2 -&gt; mẫu số = 5
        int mau = 2 * i + 1;
        double hang = 1.0 / (mau * mau);  // ép kiểu 1.0 để phép chia ra số thực
        tong = tong + hang;
    }

    return tong;
}

int main() {
    int n;
    cout &lt;&lt; "Nhập số nguyên n: ";
    cin &gt;&gt; n;

    // Gọi hàm tính tổng
    double ketQua = tinhTong(n);

    // In kết quả với 6 chữ số thập phân
    cout &lt;&lt; fixed &lt;&lt; setprecision(6);
    cout &lt;&lt; "Tổng S = " &lt;&lt; ketQua &lt;&lt; endl;

    return 0;
}Giải thích code:#include &lt;iomanip&gt;: để dùng setprecision và fixed (in số thực cố định số chữ số thập phân).using namespace std; (trong bài tập năm 1 có thể dùng để code ngắn gọn, nhưng cần hiểu rõ về namespace).double tinhTong(int n): hàm trả về kiểu double.1.0 / ...: quan trọng – nếu viết 1/(mau*mau) thì sẽ là phép chia nguyên, ra số 0.cout &lt;&lt; fixed &lt;&lt; setprecision(6): in 6 chữ số thập phân, ví dụ: 1.109874.5️⃣ 🔍 KIỂM TRA &amp; CHẠY THỬ (Câu 1)Test case 1: n = 0Công thức: chỉ số hạng đầu 111Kết quả mong đợi: 1.000000Dry run:i = 0: mau = 1, hang = 1/1 = 1, tong = 0+1 = 1hết vòng lặp → in ra 1Test case 2: n = 1Số hạng: 1+1/9=1.1111111 + 1/9 = 1.1111111+1/9=1.111111Dry run:i = 0: tong = 1i = 1: mau = 3, hang = 1/9 ≈ 0.111111, tong = 1.111111Test case 3: n = 2Kỳ vọng: 1+1/9+1/25=1+0.111111+0.04=1.1511111 + 1/9 + 1/25 = 1 + 0.111111 + 0.04 = 1.1511111+1/9+1/25=1+0.111111+0.04=1.1511116️⃣ ⚠️ LỖI THƯỜNG GẶP &amp; DEBUG (Câu 1)LỗiBiểu hiệnNguyên nhânCách sửaQuên khai báo hàmLỗi biên dịch: 'tinhTong' was not declaredĐặt hàm tinhTong sau main mà không có prototypeĐưa hàm lên trước main hoặc khai báo prototypeChia số nguyênKết quả ra 1.000000 cho mọi nViết 1/(mau*mau)Dùng 1.0/(mau*mau)In ra số thập phân ítIn ra "1" thay vì "1.111111"Không dùng setprecisionDùng cout &lt;&lt; fixed &lt;&lt; setprecision(6)Nhập n âmChương trình chạy vô hạn?Vòng lặp i &lt;= n sẽ chạy rất lâu nếu n âmNên kiểm tra: if(n &lt; 0) n = 0;Bây giờ mình sẽ giải tiếp Câu 2 hoàn toàn tương tự, nhưng với cấu trúc chi tiết hơn vì đề dài hơn.Bạn có muốn mình triển khai Câu 2 luôn theo đúng format (phân tích, tư duy, flowchart, code mẫu, test, lỗi thường gặp) không?Nếu có, mình sẽ làm ngay để bạn hoàn thiện bài tập nhé! 👨‍🏫

